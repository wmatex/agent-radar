#!/usr/bin/env sh
set -eu

# Wire format: state|last_change|working|now|idle
# Emits: state|last_change|stopped_at
awk -F '|' '
function number(v) { return v ~ /^[0-9]+$/ }
{
    state = $1
    last = $2
    working = $3
    now = $4
    idle = $5
    stopped_at = ""

    if (!number(last)) last = now

    if (working == "1" || state == "") {
        state = "working"
        last = now
    } else if (state == "stopped") {
        stopped_at = last
    } else if (number(now) && number(idle) && now - last >= idle) {
        state = "stopped"
        stopped_at = last
    }

    print state "|" last "|" stopped_at
}'
